# Configuration template only. Replace placeholders locally; never commit real keys.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_MODEL=~z-ai/glm-flash-latest
DATABASE_URL=postgresql://user:password@localhost:5432/procurebrain
PROCUREBRAIN_API_URL=http://localhost:8787

# Purchasing agent: connected or manually captured messages; email previews by default.
PROCUREBRAIN_AGENT_ORG=org-dev
PROCUREBRAIN_EMAIL_ENABLED=false
# Set these locally to enable sending. Never put real API keys in git.
RESEND_API_KEY=
PROCUREBRAIN_EMAIL_FROM=
PROCUREBRAIN_EMAIL_TO=
PROCUREBRAIN_WEB_URL=http://localhost:5173

# Connected channels. Complete setup in docs/CONNECTED_CHANNELS.md.
# The Gmail setup command writes the refresh token locally; never paste it in chat.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
PROCUREBRAIN_GMAIL_ENABLED=false
PROCUREBRAIN_TIMEZONE=Asia/Colombo

# WhatsApp Business text receiver (optional, later).
PROCUREBRAIN_WHATSAPP_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional signed intake for other systems; use a random secret of at least 32 characters.
PROCUREBRAIN_INBOUND_SECRET=
