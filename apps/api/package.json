{
  "name": "@procurebrain/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --outDir dist --noEmit false && mkdir -p dist/apps/api/migrations && cp migrations/*.sql dist/apps/api/migrations/ && cp -r document-ocr dist/apps/api/",
    "test": "vitest run",
    "evaluate:supplier-extraction": "tsx scripts/evaluate-supplier-extraction.ts",
    "typecheck": "tsc --noEmit",
    "evaluate:purchasing-agent": "tsx scripts/evaluate-purchasing-agent.ts",
    "connect:gmail": "tsx scripts/connect-gmail.ts"
  },
  "dependencies": {
    "@procurebrain/domain": "workspace:*",
    "@procurebrain/ingestion": "workspace:*",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^0.36.4",
    "google-auth-library": "^11.1.0",
    "hono": "^4.6.14",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
